# OneBhoomi Environment Configuration Example
# Copy this file to .env and configure your local settings.

# Backend Selection: 'postgres' (production default) or 'json' (emergency/legacy)
ONEBHOOMI_PERSISTENCE_BACKEND=postgres

# PostgreSQL Configuration
# Either provide a complete DATABASE_URL:
DATABASE_URL=postgresql://user:password@localhost:5432/onebhoomi

# Or provide discrete connection variables:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=onebhoomi
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=CHANGE_ME

# PostgreSQL Connection Pool Configuration
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30.0

# Web Server Port
PORT=8000

# Email Notification Configuration (SMTP)
# Optional: If not configured, notification service falls back to console output.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=noreply@onebhoomi.gov.in

# SMS Notification Configuration (Twilio REST API)
# Optional: If not configured, notification service falls back to console output.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

