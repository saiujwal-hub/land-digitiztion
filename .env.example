# OneBhoomi Environment Configuration Example
# Copy this file to .env and configure your local settings.

# Backend Selection: 'postgres' (production default) or 'json' (emergency/legacy)
ONEBHOOMI_PERSISTENCE_BACKEND=postgres

# PostgreSQL Configuration
# Either provide a complete DATABASE_URL:
DATABASE_URL=postgresql://user:password@localhost:5432/onebhoomi

# Or provide discrete connection variables:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=onebhoomi
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=CHANGE_ME

# PostgreSQL Connection Pool Configuration
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30.0

# Web Server Port
PORT=8000

